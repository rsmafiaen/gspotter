{
  "name": "t09-project-2",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "pnpm install",
    "dev": "pnpm --parallel --recursive run dev",
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "eslint .",
    "test": "pnpm --parallel --recursive run test",
    "test:frontend": "pnpm --filter @t09-project-2/frontend run test",
    "test:frontend:watch": "pnpm --filter @t09-project-2/frontend run test:watch",
    "test:backend": "pnpm --filter @t09-project-2/backend run test",
    "format": "prettier --write . && eslint . --fix",
    "check": "prettier --check .",
    "generate-routes": "pnpm --filter @t09-project-2/frontend run generate-routes",
    "db:setup": "bash scripts/setup-db.sh",
    "db:generate": "pnpm --filter @t09-project-2/db run db:generate",
    "db:push": "pnpm --filter @t09-project-2/db run db:push",
    "db:migrate": "pnpm --filter @t09-project-2/db run db:migrate",
    "db:deploy": "pnpm --filter @t09-project-2/db run db:deploy",
    "db:baseline": "bash scripts/baseline-db.sh",
    "db:seed": "pnpm --filter @t09-project-2/db run db:seed",
    "db:studio": "pnpm --filter @t09-project-2/db run db:studio",
    "azure:register-providers": "bash scripts/register-azure-providers.sh"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "latest",
    "eslint": "latest",
    "prettier": "^3.9.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "@prisma/engines",
      "prisma",
      "@apollo/protobufjs",
      "unrs-resolver"
    ]
  }
}
