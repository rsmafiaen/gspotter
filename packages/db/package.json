{
  "name": "@t09-project-2/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "dotenv -e .env -- prisma generate",
    "db:push": "dotenv -e .env -- prisma db push",
    "db:migrate": "dotenv -e .env -- prisma migrate dev",
    "db:deploy": "dotenv -e .env -- prisma migrate deploy",
    "db:seed": "dotenv -e .env -- prisma db seed",
    "db:studio": "dotenv -e .env -- prisma studio",
    "db:reset": "dotenv -e .env -- prisma migrate reset",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "prisma": "^7.10.0"
  },
  "devDependencies": {
    "@pothos/plugin-prisma": "^4.0.0",
    "@types/node": "^22.20.4",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
