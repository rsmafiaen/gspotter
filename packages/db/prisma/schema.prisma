generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator pothos {
  provider     = "prisma-pothos-types"
  clientOutput = "./prisma"
  output       = "../src/generated/pothos-types.ts"
}

datasource db {
  provider = "postgresql"
}

enum GlassSize {
  PINT          @map("PINT")
  HALF_LITER    @map("HALF_LITER")
  QUARTER_LITER @map("QUARTER_LITER")
  BOX           @map("BOX")
  OTHER         @map("OTHER")

  @@map("glass_size")
}

enum Limitations {
  TIME       @map("TIME")
  MEMBERSHIP @map("MEMBERSHIP")

  @@map("limitations")
}

enum Day {
  MON @map("MON")
  TUE @map("TUE")
  WED @map("WED")
  THU @map("THU")
  FRI @map("FRI")
  SAT @map("SAT")
  SUN @map("SUN")

  @@map("day")
}

model Venue {
  id      String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name    String
  address String
  lat     Float
  lon     Float

  openingHours      OpeningHours[]
  openingHoursNotes OpeningHoursNote[]

  cityId String @map("city_id") @db.Uuid
  city   City   @relation(fields: [cityId], references: [id])

  pricesSighted PriceSighting[]
  reviews       Review[]

  @@map("venue")
}

model OpeningHours {
  id      String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  days    Day[]
  opening DateTime @db.Timetz()
  closing DateTime @db.Timetz()

  venueId String @map("venue_id") @db.Uuid
  venue   Venue  @relation(fields: [venueId], references: [id])

  @@map("opening_hours")
}

model OpeningHoursNote {
  id   String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  days Day[]
  note String

  venueId String @map("venue_id") @db.Uuid
  venue   Venue  @relation(fields: [venueId], references: [id])

  @@map("opening_hours_note")
}

model City {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  centreLon Float  @map("centre_lon")
  centreLat Float  @map("centre_lat")

  venues Venue[]

  @@map("city")
}

model PriceSighting {
  id          String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  price       Float
  size        GlassSize
  limitation  Limitations[]
  timeStart   DateTime?     @map("time_start") @db.Timetz()
  timeEnd     DateTime?     @map("time_end") @db.Timetz()
  sizeMl      Float?        @map("size_ml")
  timeSighted DateTime      @map("time_sighted") @db.Timestamptz()

  venueId String @map("venue_id") @db.Uuid
  venue   Venue  @relation(fields: [venueId], references: [id])

  @@map("price_sighting")
}

model Review {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  username    String
  body        String
  rating      Int
  timeCreated DateTime @default(dbgenerated("now()")) @map("time_created") @db.Timestamptz()

  venueId String @map("venue_id") @db.Uuid
  venue   Venue  @relation(fields: [venueId], references: [id])

  @@map("review")
}
